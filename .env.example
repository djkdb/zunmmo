# Copy to .env.local. Local values come from `pnpm db:start` (Supabase CLI defaults).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show "Google로 계속하기" only when the Google provider is configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Preview deployments only: render /styleguide in production builds.
# ENABLE_STYLEGUIDE=1

# Shown on /privacy and /terms as the operator's contact address. Required before launch.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: server errors are also POSTed here as JSON (no headers or bodies are sent).
# ERROR_WEBHOOK_URL=
